# Railway CAD server — copy to Railway service variables
OPENROUTER_API_KEY=sk-or-...
CAD_ALLOW_ANONYMOUS=0
CAD_API_KEY=
# JWT: CAD_JWT_SECRET is the exclusive verify secret when set. SUPABASE_JWT_SECRET is fallback only if CAD_JWT_SECRET is unset. Never both.
CAD_JWT_SECRET=
SUPABASE_JWT_SECRET=
# AES-256-GCM master key for provider_profiles (32 bytes: 64 hex chars or base64). Never a provider API key.
CAD_PROFILE_ENCRYPTION_KEY=
CAD_PROFILE_ENCRYPTION_KEY_VERSION=1
# Previous versions for decrypt after a bump, e.g. CAD_PROFILE_ENCRYPTION_KEY_V1 when current version is 2.
# CAD_PROFILE_ENCRYPTION_KEY_V1=
# Faza 1 default true. Set false after 95% profile traffic for 14 days + 30 day notice.
CAD_LEGACY_CLIENT_SECRET_PAYLOAD=true
# Text-to-3D: PiAPI Trellis (preferred), optional self-hosted worker, Meshy fallback
PIAPI_API_KEY=
PIAPI_BASE_URL=https://api.piapi.ai
MESH_WORKER_URL=
MESH_WORKER_TOKEN=
MESHY_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CAD_MAX_RENDER_MS=120000
CAD_LLM_MODEL=openai/gpt-4o-mini
MESH_WORKER_TIMEOUT_MS=600000
